# ============================================================
#  Caddyfile — 最省事的公网部署：自动申请并续期 HTTPS 证书
#
#  前置条件:
#    1. 有域名，A 记录指向服务器公网 IP
#    2. 服务器 80 / 443 端口对公网开放
#
#  用法 A（宿主机）:
#    sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#    sudo sed -i 's/calc.example.com/你的域名/' /etc/caddy/Caddyfile
#    sudo systemctl reload caddy
#
#  用法 B（docker-compose）: 见 deploy/docker-compose.yml 里的 caddy 服务
# ============================================================

# ---------- 场景 1: 静态版，Caddy 直接托管 out/（推荐）----------
calc.example.com {
	root * /var/www/farm-cooling        # 换成 out/ 的绝对路径
	encode gzip zstd
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Next.js 产物带内容哈希，可长缓存
	@nextStatic path /_next/static/*
	header @nextStatic Cache-Control "public, max-age=31536000, immutable"

	# Service Worker 不缓存
	@sw path /sw.js
	header @sw Cache-Control "no-cache, no-store, must-revalidate"

	# 页面不缓存
	@html path / /index.html
	header @html Cache-Control "no-cache, must-revalidate"

	# 静态导出的路由: /foo -> foo.html
	try_files {path} {path}.html {path}/index.html /index.html

	log {
		output file /var/log/caddy/farm-cooling.log
		format console
	}
}

# ---------- 场景 2: 反代 standalone Node 服务器 ----------
# calc.example.com {
# 	encode gzip zstd
# 	reverse_proxy 127.0.0.1:3000
# }

# ---------- 场景 3: 没有域名，用 IP + 端口（无 HTTPS）----------
# :8080 {
# 	root * /var/www/farm-cooling
# 	encode gzip
# 	file_server
# 	try_files {path} {path}.html {path}/index.html /index.html
# }
