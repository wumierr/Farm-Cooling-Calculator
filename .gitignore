# ============================================================
# .gitignore — 葡萄大棚降温剂计算器
# 策略：忽略所有与公网部署无关的文件，保留 APK 打包脚本
# ============================================================

# ---- 依赖 ----
node_modules/
/.pnp
.pnp.*

# ---- Next.js 构建产物 ----
/.next/
/out/

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- 环境变量（含密钥，不上传）----
.env
.env*
!.env.example

# ---- 日志 ----
*.log
dev.log
server.log
logs/

# ---- 运行时临时文件 ----
.server.pid

# ---- Capacitor / Android 构建工具链 ----
# 只忽略「生成物」，保留打包脚本和配置 —— 否则换台机器 clone 下来没法打 APK
apk-build/android/
apk-build/node_modules/
apk-build/.gradle/
*.apk
*.aab
*.keystore
*.jks

# ---- 项目临时文件（开发环境专用，部署不需要）----
upload/
download/
tool-results/
examples/
mini-services/
db/
.zscripts/
.claude
.z-ai-config

# ---- 开发文档（可选：保留 worklog.md 用于协作）----
# worklog.md

# ---- 系统文件 ----
.DS_Store
*.pem
*.swp
*~

# ---- 编辑器 ----
.vscode/
.idea/

# ---- 测试 ----
/coverage
test
prompt
local-*
