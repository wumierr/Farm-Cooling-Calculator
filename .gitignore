# ============================================================
# .gitignore — 葡萄大棚降温剂计算器
# 策略：忽略所有与公网部署无关的文件，保留 APK 打包脚本
# ============================================================

# ---- 依赖 ----
node_modules/
/.pnp
.pnp.*

# ---- Next.js 构建产物 ----
/.next/
/out/

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- 环境变量（含密钥，不上传）----
.env
.env*
!.env.example

# ---- 日志 ----
*.log
dev.log
server.log

# ---- 运行时临时文件 ----
.server.pid

# ---- Capacitor / Android 构建工具链 ----
# 忽略整个 APK 构建环境（脚本、配置、Android 工程）
# APK 产物通过 GitHub Release 单独发布，不进仓库
apk-build/
*.keystore
*.jks

# ---- 项目临时文件（开发环境专用，部署不需要）----
upload/
download/
tool-results/
examples/
mini-services/
db/
.zscripts/
.claude
.z-ai-config

# ---- 开发文档（可选：保留 worklog.md 用于协作）----
# worklog.md

# ---- 防止 Windows 设备文件名被误写入（如 bash 下 >nul 生成的物理文件）----
nul
NUL

# ---- 系统文件 ----
.DS_Store
*.pem
*.swp
*~

# ---- 编辑器 ----
.vscode/
.idea/

# ---- 测试 ----
/coverage
test
prompt
local-*
